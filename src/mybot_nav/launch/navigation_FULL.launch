<?xml version="1.0" encoding="utf-8"?>

<launch>
  <!-- <arg name="scan_topic"      default="scan"/>  -->

 
  <!--- Launch gazebo World -->
<include file="$(find gazebo_pkg)/launch/mybot_world.launch"/>

<!-- Convert Image to Laser Scan if we use kinect camera -->
<node name="depthimage_to_laserscan" pkg="depthimage_to_laserscan" type="depthimage_to_laserscan">
    <param name="output_frame_id" value="camera_link"/>
    <remap from="image" to="/camera/depth/image_raw"/>
</node>


<!-- Include Rviz  -->
<include file="$(find mybot_description)/launch/mybot_rviz.launch"/>
  <!-- <node name="rviz" pkg="rviz" type="rviz" args="-d $(find wheelchair_nav)/config/nav.rviz" /> -->


  <!-- Map Server -->
  <!-- <arg name="map" default="$(find wheelchair_nav)/map/mymapPreEnd.yaml"/> -->
      <!-- <arg name="map" default="$(find wheelchair_nav)/map/Room.yaml"/>     -->
      <arg name="map" default="$(find mybot_nav)/map/careCenter.yaml"/>
  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map)"/>
  
  <rosparam file="$(find mybot_nav)/config/controllers.yaml" command="load"/>
  <node name="controller_spawner" pkg="controller_manager" 
  type="spawner" respawn="false" output="screen" 
  ns="/mywheelchair_description" 
  args="left_wheel_controller right_wheel_controller joint_state_controller"/>



  <!-- AMCL  -->
   <include file="$(find mybot_nav)/launch/amcl.launch"/>
 
  <!-- <include file="$(arg amcl_launch_xml)"/> -->
  <!-- OR -->
   <arg name="move_forward_only" default="true "/>
 
  <!-- <node pkg="tf" type="static_transform_publisher" name="map_odom_broadcaster" args="0 0 0 0 0 0 /map /odom 100"/> -->
  
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <param name="recovery_behavior_enabled"	value="true"/>
    <param name= "clearing_rotation_allowed"	value="true" />
    <param name= "rotate_recovery"	value="true" />
    <param name= "move_slow_and_clear"	value="false" /> 
   

    <rosparam file="$(find mybot_nav)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find mybot_nav)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find mybot_nav)/config/local_costmap_params.yaml" command="load" />
    <rosparam file="$(find mybot_nav)/config/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find mybot_nav)/config/base_local_planner_params.yaml" command="load" />
    <rosparam file="$(find mybot_nav)/config/move_base_params.yaml" command="load" />

    <!-- <param file="$(find wheelchair_nav)/config/base_local_planner_params.yaml" command="load" /> -->
        <!-- Load the local planner plugin -->
        <!-- <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS" /> -->
        <!-- Load the global planner plugin -->
        <!-- <param name="base_global_planner" value="global_planner/GlobalPlanner" /> -->
    <!-- <remap from="scan" to="$(arg scan_topic)"/> -->
  </node>       
</launch>
